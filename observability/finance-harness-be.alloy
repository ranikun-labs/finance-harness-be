// Merge into the Alloy configuration that defines prometheus.remote_write.default.
// Attach Alloy to the Compose private network; port 8081 is not published on the host.
prometheus.scrape "finance_harness_be" {
  targets = [
    {
      __address__ = "finance-harness-be:8081",
      service     = "finance-harness-be",
      environment = "production",
    },
  ]

  metrics_path    = "/actuator/prometheus"
  scrape_interval = "15s"
  scrape_timeout  = "5s"
  forward_to      = [prometheus.remote_write.default.receiver]
}
